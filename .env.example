# ── Database ──────────────────────────────────────────────
# memory://                       — in-memory (tests/default)
# sqlite:///./library.db          — SQLite file (local dev)
# postgresql://user:pass@host:5432/db — PostgreSQL (production)
DATABASE_URL=memory://

# ── Redis ─────────────────────────────────────────────────
# redis://localhost:6379/0         — local dev
# redis://redis:6379/0             — Docker (service name)
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────
# Must be >= 32 characters
SECRET_KEY=change-me-to-a-secret-key-at-least-32-characters-long

# ── JWT ───────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────
# JSON list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# ── Environment ───────────────────────────────────────────
# development | staging | production
ENV=development

# ── Logging ───────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
