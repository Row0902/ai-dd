# Database Configuration
# memory:// — in-memory repository (tests/default)
# sqlite:///./library.db — SQLite file (local dev)
# postgresql://user:password@host:5432/db — PostgreSQL (production)
DATABASE_URL=memory://

# Security
SECRET_KEY=change-me-to-a-secret-key-at-least-32-characters-long

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Environment
ENV=development

# Logging
LOG_LEVEL=INFO
